# Add Neon PostgreSQL connection string (Vercel Storage > Neon or neon.tech)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Set a strong, unique password. Do not commit secrets.
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
# Generate with `openssl rand -hex 32` or equivalent
SESSION_SECRET=CHANGE_THIS_TO_64_RANDOM_HEX_CHARACTERS
